<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CLI entitlements for the -Dgpu-venus build: the hypervisor entitlement
	     (as in cli.entitlements) PLUS the library-validation/JIT relaxations the
	     Venus stack needs to load the ad-hoc-signed virglrenderer/KosmicKrisp
	     dylibs and let MoltenVK/KosmicKrisp JIT Metal shaders. -->
	<key>com.apple.security.hypervisor</key>
	<true/>
	<key>com.apple.security.virtualization</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
