+/* VK_EXT_transform_feedback */
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
+                                      uint32_t firstBinding,
+                                      uint32_t bindingCount,
+                                      const VkBuffer *pBuffers,
+                                      const VkDeviceSize *pOffsets,
+                                      const VkDeviceSize *pSizes)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      VK_FROM_HANDLE(kk_buffer, buffer, pBuffers[i]);
+      uint64_t size = pSizes ? pSizes[i] : VK_WHOLE_SIZE;
+
+      gfx->xfb.buffers[firstBinding + i] =
+         kk_buffer_addr_range(buffer, pOffsets[i], size);
+   }
+}
+
+static void
+kk_begin_end_xfb(VkCommandBuffer commandBuffer, uint32_t firstCounterBuffer,
+                 uint32_t counterBufferCount, const VkBuffer *pCounterBuffers,
+                 const VkDeviceSize *pCounterBufferOffsets, bool begin)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   gfx->xfb.enabled = begin;
+
+   /* Running byte offsets live in a per-command-buffer GPU array. */
+   if (!gfx->xfb.offsets)
+      gfx->xfb.offsets = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4).gpu;
+
+   struct libkk_xfb_counter_copy params = {0};
+   unsigned copies = 0;
+
+   /* Begin initializes every offset (0 when no counter buffer supplies it);
+    * End writes the final offsets back into the counter buffers.
+    */
+   if (begin) {
+      for (copies = 0; copies < 4; ++copies)
+         params.dest[copies] = gfx->xfb.offsets + copies * sizeof(uint32_t);
+   }
+
+   for (unsigned i = 0; i < counterBufferCount; ++i) {
+      if (pCounterBuffers == NULL || pCounterBuffers[i] == VK_NULL_HANDLE)
+         continue;
+
+      VK_FROM_HANDLE(kk_buffer, buffer, pCounterBuffers[i]);
+
+      uint64_t offset = pCounterBufferOffsets ? pCounterBufferOffsets[i] : 0;
+      uint64_t cb_addr = vk_buffer_address(&buffer->vk, offset);
+      uint32_t cmd_idx = firstCounterBuffer + i;
+
+      if (begin) {
+         params.src[cmd_idx] = cb_addr;
+      } else {
+         params.dest[copies] = cb_addr;
+         params.src[copies] = gfx->xfb.offsets + cmd_idx * sizeof(uint32_t);
+         ++copies;
+      }
+   }
+
+   if (begin)
+      copies = 4;
+
+   if (copies > 0) {
+      struct kk_ptr push =
+         kk_pool_upload(cmd, &params, sizeof(params), 8);
+      if (push.gpu)
+         libkk_copy_xfb_counters(cmd, kk_grid_1d(copies), true, push.gpu);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                                uint32_t firstCounterBuffer,
+                                uint32_t counterBufferCount,
+                                const VkBuffer *pCounterBuffers,
+                                const VkDeviceSize *pCounterBufferOffsets)
+{
+   kk_begin_end_xfb(commandBuffer, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                              uint32_t firstCounterBuffer,
+                              uint32_t counterBufferCount,
+                              const VkBuffer *pCounterBuffers,
+                              const VkDeviceSize *pCounterBufferOffsets)
+{
+   kk_begin_end_xfb(commandBuffer, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, false);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawIndirectByteCountEXT(VkCommandBuffer commandBuffer,
+                               uint32_t instanceCount, uint32_t firstInstance,
+                               VkBuffer counterBuffer,
+                               VkDeviceSize counterBufferOffset,
+                               uint32_t counterOffset, uint32_t vertexStride)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_buffer, buffer, counterBuffer);
+
+   if (instanceCount == 0)
+      return;
+
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   /* Turn the byte counter into a VkDrawIndirectCommand on the GPU, then
+    * treat it as a regular single indirect draw.
+    */
+   struct kk_ptr draw_cmd = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4);
+   if (!draw_cmd.gpu)
+      return;
+
+   libkk_xfb_indirect_from_counter(
+      cmd, kk_grid_1d(1), true, draw_cmd.gpu,
+      vk_buffer_address(&buffer->vk, counterBufferOffset), counterOffset,
+      vertexStride, instanceCount, firstInstance);
+
+   struct kk_draw_command data = {
+      .prim = vk_topology_to_mesa(dyn->ia.primitive_topology),
+      .upload_mask = build_per_draw_upload_mask(cmd),
+      .indirect = true,
+      .predicate_count = cmd->state.cond_render.enabled ? 1u : 0u,
+      .predicate_op[0] = cmd->state.cond_render.inverted
+                            ? KK_PREDICATE_EQ_ZERO
+                            : KK_PREDICATE_NEQ_ZERO,
+      .predicate_addr[0] = cmd->state.cond_render.address,
+      .draw_count = 1,
+      .indirect_command.addr = draw_cmd.gpu,
+      .indirect_command.stride = 4 * sizeof(uint32_t),
+   };
+
+   kk_draw(cmd, &data);
+}
