+/* Convert a poly-produced geometry pipeline stage to a compute shader.
+ * Optionally insert an x-dimension bounds guard: poly grids are written in
+ * threads but Metal indirect dispatch has threadgroup granularity, so
+ * indirect launches over-dispatch up to the workgroup size.
+ */
+static void
+kk_gs_stage_to_compute(nir_shader *nir, bool guard_x)
+{
+   if (guard_x) {
+      nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+      nir_builder b = nir_builder_at(nir_before_impl(impl));
+      nir_def *gid = nir_channel(&b, nir_load_global_invocation_id(&b, 32), 0);
+      nir_def *base = nir_load_geometry_param_buffer_poly(&b);
+      nir_def *addr =
+         nir_iadd_imm(&b, base, offsetof(struct poly_geometry_params, grid));
+      nir_def *max_x = nir_load_global_constant(&b, 1, 32, addr);
+      nir_push_if(&b, nir_uge(&b, gid, max_x));
+      nir_jump(&b, nir_jump_return);
+      nir_pop_if(&b, NULL);
+      nir_progress(true, impl, nir_metadata_none);
+   }
+
+   nir->info.stage = MESA_SHADER_COMPUTE;
+   memset(&nir->info.cs, 0, sizeof(nir->info.cs));
+   nir->xfb_info = NULL;
+}
