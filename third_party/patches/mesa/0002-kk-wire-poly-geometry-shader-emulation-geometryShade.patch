+static struct kk_draw_data
+kk_launch_gs(struct kk_cmd_buffer *cmd, struct kk_draw_data draw)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct poly_gs_info *gsi =
+      &cmd->state.shaders[MESA_SHADER_GEOMETRY]->info.gs.poly;
+   uint64_t params = gfx->per_draw_data.geometry_params;
+   struct kk_grid grid_vs, grid_gs;
+
+   enum mesa_prim mode = draw.mesa_prim;
+
+   if (kk_grid_is_indirect(draw.grid)) {
+      struct libkk_gs_setup_indirect_args args = {
+         .draw = draw.grid.addr,
+         .vp = gfx->per_draw_data.vertex_params,
+         .p = params,
+         .heap = kk_heap(cmd),
+         .vs_outputs = vs->info.vs.outputs_written,
+         .prim = mode,
+         .is_prefix_summing = gsi->prefix_sum,
+         .max_indices = gsi->max_indices,
+         .shape = gsi->shape,
+      };
+
+      if (draw.index.el_size_B) {
+         args.index_buffer = draw.index.gpu.addr;
+         args.index_size_B = draw.index.el_size_B;
+         args.index_buffer_range_el =
+            draw.index.gpu.range / draw.index.el_size_B;
+      }
+
+      libkk_gs_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+
+      grid_vs = kk_grid_indirect(gfx->per_draw_data.vertex_params +
+                                 offsetof(struct poly_vertex_params, grid));
+      grid_gs = kk_grid_indirect(params +
+                                 offsetof(struct poly_geometry_params, grid));
+   } else {
+      grid_vs = kk_grid_2d(draw.grid.size.x, draw.grid.size.y);
+      grid_gs =
+         kk_grid_2d(u_decomposed_prims_for_vertices(mode, draw.grid.size.x),
+                    draw.grid.size.y);
+
+      /* Avoid Metal validation errors on empty dispatches. */
+      if (grid_vs.size.x == 0u || grid_gs.size.x == 0u)
+         return (struct kk_draw_data){.grid = kk_grid_1d(0u)};
+   }
+
+   /* Compute prepasses: sw-VS then the main GS. The count and pre-GS
+    * pipelines (slots 1..n-2 when present) are only needed for transform
+    * feedback and queries, which are not wired yet. */
+   mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+   const struct mtl_size local_size = {64, 1, 1};
+   {
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_DISPATCH);
+      mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.pre_render[0]);
+      kk_dispatch_compute(enc, grid_vs, local_size);
+   }
+   {
+      uint32_t main_idx = vs->pipeline.gfx.pre_render_count - 1u;
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_DISPATCH);
+      mtl_compute_set_pipeline_state(enc,
+                                     vs->pipeline.gfx.pre_render[main_idx]);
+      kk_dispatch_compute(enc, grid_gs, local_size);
+   }
+
+   /* Rewrite the draw to source the GS emulation output. */
+   struct kk_draw_data out = {
+      .mesa_prim = gfx->gs.rast_prim,
+      .primitive_type = mesa_prim_to_mtl_primitive_type(gfx->gs.rast_prim),
+   };
+
+   bool indirect = kk_grid_is_indirect(draw.grid);
+   if (indirect) {
+      out.grid = kk_grid_indirect(params +
+                                  offsetof(struct poly_geometry_params, draw));
+   } else {
+      out.grid = kk_grid_3d(gfx->gs.index_count, gfx->gs.instance_count, 0u);
+   }
+
+   if (poly_gs_indexed(gsi->shape)) {
+      /* 8-bit static topologies are widened to 16-bit at upload. */
+      out.index.el_size_B =
+         gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED ? 2u : 4u;
+      out.index.gpu.addr = gfx->gs.index_buffer;
+      if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED && indirect) {
+         out.index.gpu.range = dev->heap->size_B - sizeof(struct poly_heap);
+      } else if (gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED) {
+         out.index.gpu.range = gsi->max_indices * 2u;
+      } else {
+         out.index.gpu.range = gfx->gs.index_count * 4u;
+      }
+   }
+
+   return out;
+}
