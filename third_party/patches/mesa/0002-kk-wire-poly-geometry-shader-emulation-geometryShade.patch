+static void
+kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
+                          struct poly_geometry_params *out,
+                          const struct kk_draw_data *draw)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *gs = cmd->state.shaders[MESA_SHADER_GEOMETRY];
+   const struct poly_gs_info *gsi = &gs->info.gs.poly;
+
+   bool indirect = kk_grid_is_indirect(draw->grid);
+   enum mesa_prim mode = draw->mesa_prim;
+
+   const uint32_t wg_size[3] = {64, 1, 1};
+   poly_geometry_params_init(out, mode, wg_size);
+
+   /* Transform feedback is not wired yet: all xfb pointers stay zero and the
+    * xfb/query prepasses are not dispatched. */
+
+   out->count_buffer_stride = gsi->count_words * 4;
+
+   if (!gsi->prefix_sum && out->count_buffer_stride) {
+      struct kk_ptr T = kk_pool_alloc(cmd, 16, 4);
+      if (T.cpu)
+         memset(T.cpu, 0, 16);
+      out->count_buffer = T.gpu;
+   }
+
+   if (indirect) {
+      if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED) {
+         /* Rasterization indices are allocated from the heap by the GS
+          * indirect setup kernel. */
+         kk_heap(cmd);
+         gfx->gs.index_buffer = dev->heap->gpu + sizeof(struct poly_heap);
+         gfx->gs.index_count = 0; /* range covers the whole heap */
+      } else {
+         gfx->gs.index_count =
+            poly_gs_rast_vertices(gsi->shape, gsi->max_indices, 1, 0);
+      }
+   } else {
+      poly_geometry_params_set_draw(out, mode, gsi->shape, gsi->max_indices,
+                                    draw->grid.size.x, draw->grid.size.y);
+
+      unsigned size = out->input_primitives * out->count_buffer_stride;
+      if (gsi->prefix_sum && size)
+         out->count_buffer = kk_pool_alloc(cmd, size, 4).gpu;
+
+      gfx->gs.index_count = out->draw.index_count;
+      gfx->gs.instance_count = out->draw.instance_count;
+
+      if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED) {
+         out->output_index_buffer =
+            kk_pool_alloc(cmd, gfx->gs.index_count * 4, 4).gpu;
+         gfx->gs.index_buffer = out->output_index_buffer;
+      }
+   }
+
+   if (gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED) {
+      /* poly encodes the static topology as 8-bit indices, which Metal cannot
+       * draw; widen to 16-bit at upload time. */
+      uint16_t topology16[64];
+      for (uint32_t i = 0; i < gsi->max_indices && i < 64; ++i)
+         topology16[i] = gsi->topology[i];
+      gfx->gs.index_buffer =
+         kk_pool_upload(cmd, topology16, gsi->max_indices * 2, 2).gpu;
+   }
+}
