From 560392e4d08d2ddbe974d864db9afd1c052721b2 Mon Sep 17 00:00:00 2001
From: Uzair Aftab <git@uzaaft.me>
Date: Tue, 28 Jul 2026 21:15:48 +0200
Subject: [PATCH 1/3] kk: implement VK_EXT_depth_clip_enable

Metal has a single clip-or-clamp switch (MTLDepthClipMode), so clamp
whenever depth clamping is enabled or clipping is disabled; the
clamp-off+clip-off combination is unrepresentable and degrades to clamp.
Gates zink GL 3.2.
---
 src/kosmickrisp/vulkan/kk_cmd_draw.c        | 10 ++++++++--
 src/kosmickrisp/vulkan/kk_physical_device.c |  4 ++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 55080ee31c..29c66b9713 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1239,8 +1239,14 @@ kk_flush_dynamic_state(struct kk_cmd_buffer *cmd)
          mtl_set_depth_bias(enc, 0.0f, 0.0f, 0.0f);
    }
 
-   if (IS_DIRTY(RS_DEPTH_CLAMP_ENABLE)) {
-      enum mtl_depth_clip_mode mode = dyn->rs.depth_clamp_enable
+   if (IS_DIRTY(RS_DEPTH_CLAMP_ENABLE) || IS_DIRTY(RS_DEPTH_CLIP_ENABLE)) {
+      /* Metal has a single clip-or-clamp switch, so clamp whenever depth
+       * clamping is enabled or clipping is disabled (VK_EXT_depth_clip_enable
+       * decouples the two; the clamp-off + clip-off combination is not
+       * representable and degrades to clamp).
+       */
+      const bool clip = vk_rasterization_state_depth_clip_enable(&dyn->rs);
+      enum mtl_depth_clip_mode mode = (dyn->rs.depth_clamp_enable || !clip)
                                          ? MTL_DEPTH_CLIP_MODE_CLAMP
                                          : MTL_DEPTH_CLIP_MODE_CLIP;
       mtl_set_depth_clip_mode(enc, mode);
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index f7da7bf5f3..2ee740f815 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -171,6 +171,7 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .EXT_custom_resolve = true,
       .EXT_debug_marker = true,
       .EXT_depth_clip_control = true,
+      .EXT_depth_clip_enable = true,
       .EXT_extended_dynamic_state3 = true,
       .EXT_external_memory_metal = true,
       .EXT_external_memory_host = true,
@@ -435,6 +436,9 @@ kk_get_device_features(
       /* VK_EXT_depth_clip_control */
       .depthClipControl = true,
 
+      /* VK_EXT_depth_clip_enable */
+      .depthClipEnable = true,
+
       /* VK_EXT_extended_dynamic_state3 */
       .extendedDynamicState3DepthClampEnable = true,
       .extendedDynamicState3DepthClipNegativeOneToOne = true,
-- 
