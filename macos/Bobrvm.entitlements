<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by Hypervisor.framework. The app is intentionally not sandboxed so that
         persistent VM disks and user-selected installation media remain accessible. -->
    <key>com.apple.security.hypervisor</key>
    <true/>
</dict>
</plist>
