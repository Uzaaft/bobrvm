<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Venus GPU stack loads third-party dylibs (virglrenderer, ANGLE,
	     MoltenVK, the Vulkan loader) signed by other identities, and MoltenVK
	     JITs Metal shaders. These entitlements let a codesigned bobrvm load and
	     run them. Used by the -Dgpu-venus build; the hypervisor entitlement
	     from cli.entitlements is merged in at sign time for the CLI. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
